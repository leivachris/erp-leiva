# ============================================================
# ERP LEIVA - Variables de entorno (ejemplo)
# Copia este fichero a .env y personaliza los valores
# ============================================================

# CLAVE DE SESION - MUY IMPORTANTE: cambiar en produccion
# Minimo 32 caracteres aleatorios
ERP_SECRET_KEY=cambia-esto-clave-secreta-minimo-32-caracteres-aleatorios-2026

# Nombre de la empresa por defecto (aparece en banner y facturas)
ERP_EMPRESA_NOMBRE=Centro Logistico de Almacenes

# Zona horaria
TZ=Europe/Madrid